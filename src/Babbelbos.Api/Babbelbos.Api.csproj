<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>babbelbos-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <!-- Dynamic handler code generation; switch to pre-generated code (TypeLoadMode.Static) for production later. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Babbelbos.ServiceDefaults\Babbelbos.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Modules\Conversations\Conversations.Infrastructure\Conversations.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\GnomeCatalog\GnomeCatalog.Infrastructure\GnomeCatalog.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Gnome definitions and prompts are read at startup from prompts/ next to the app. -->
    <None Include="..\..\prompts\**\*" LinkBase="prompts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
